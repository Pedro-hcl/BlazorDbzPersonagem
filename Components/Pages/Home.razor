@page "/"
@inject HttpClient Http
@rendermode InteractiveServer
@using BlazorDbzPersonagem.Models

<PageTitle>Home</PageTitle>

<h1>Informações do Personagem:</h1>

<div class="mb-3" >
<label for="idInput" class="form-label"> Digite o Id do personagem:</label>
<input type="text" id="idInput" class="form-control" @bind="id"/>
</div>

<button class="btn btn-primary" @onclick="BuscarPersonagem">Buscar</button>

@if (personagem != null)
{
    <div class="mt-3">
        <h1>@personagem.name</h1>
        <p><strong>Nome:</strong> @personagem.name</p>
        <img src="@personagem.image" alt="@personagem.name" style="width: 200px;" />
        <p><strong>Planeta de Origem:</strong> @personagem.OriginPlanet?.Name</p>
        <h1><strong>Transformações:</strong></h1>
        <ul style="list-style: none;">
            @foreach (var transformation in personagem.Transformations ?? new List<Transformation>())
            {
                <li><strong>@transformation.Name</strong></li>
                <li><img src="@transformation.image" alt="@transformation.Name" style="width: 100px;" /></li>
            }
        </ul>
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">@errorMessage</div>
}

@code {
    private string id;

    private personagem personagem;

    private string errorMessage;

    private async Task BuscarPersonagem()
    {
        errorMessage = string.Empty;
        personagem = null;

        if (string.IsNullOrWhiteSpace(id))
        {
            errorMessage = "Por favor, insira um Id válido.";
            return;
        }

        try
        {
            var url = $"https://dragonball-api.com/api/characters/{id}"; 
            personagem = await Http.GetFromJsonAsync<personagem>(url);


        }
        catch (Exception ex)
        {
            errorMessage = $"Ocorreu um erro ao consultar o personagem: {ex.Message}";
        }
}

}